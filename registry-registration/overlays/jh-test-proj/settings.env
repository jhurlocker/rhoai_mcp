# Deploy and register the project-local MCP runtime as an available server.
REGISTRY_WORKSPACE=jh-test-proj
REGISTRY_URL=https://mlflow.redhat-ods-applications.svc:8443/mlflow
APPLICATION_ID=jh-test-proj-mcp-registration
MCP_NAMESPACE=jh-test-proj
MCP_NAME=rhoai-mcp
MCP_URL=http://rhoai-mcp.jh-test-proj.svc.cluster.local:8000/mcp
MCP_DISCOVERY_URL=http://rhoai-mcp.jh-test-proj.svc.cluster.local:8000/mcp
MCP_ROUTE_NAME=rhoai-mcp
MCP_WAIT_SECONDS=180
SERVER_VERSION=1.29.1
REGISTRY_SERVER_NAME=com.redhat/rhoai-mcp-server
MCP_OWNER=admin
MCP_SECURITY_DOMAIN=poc
MCP_SUPPORT_CONTACT=OpenShift project jh-test-proj administrators
REGISTER_REAL=true
DISCOVER_REAL=true
CAPABILITIES_FILE=/data/capabilities.json
REAL_VERSION_STATUS=active
ENSURE_ACCESS_ENDPOINT=true
REGISTER_POC=false
POC_RECORD_NAME=io.example/mcp-acceptance-jh-test-proj

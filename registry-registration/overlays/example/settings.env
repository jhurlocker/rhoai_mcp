# Set namespace in kustomization.yaml and REGISTRY_WORKSPACE to the SAME existing project.
REGISTRY_WORKSPACE=rhoai-mcp
REGISTRY_URL=https://mlflow.redhat-ods-applications.svc:8443/mlflow
MCP_NAMESPACE=rhoai-mcp
MCP_NAME=rhoai-mcp
MCP_URL=http://rhoai-mcp.rhoai-mcp.svc.cluster.local:8000/mcp
SERVER_VERSION=1.29.1
REGISTRY_SERVER_NAME=com.redhat/rhoai-mcp-server-poc
MCP_OWNER=replace-with-your-team
MCP_SECURITY_DOMAIN=replace-with-your-domain
MCP_SUPPORT_CONTACT=replace-with-your-contact
# Set true to ALSO load the three synthetic draft versions from poc-versions.json.
REGISTER_POC=false
